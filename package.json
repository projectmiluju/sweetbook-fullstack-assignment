{
  "name": "sweetbook-fullstack-assignment",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @sweetbook/api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter @sweetbook/api build",
    "lint": "pnpm lint:web",
    "lint:web": "pnpm --filter web lint",
    "typecheck": "pnpm typecheck:api",
    "typecheck:api": "pnpm --filter @sweetbook/api exec tsc -p tsconfig.json --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx,mjs}": [
      "pnpm --filter web exec eslint --fix"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
